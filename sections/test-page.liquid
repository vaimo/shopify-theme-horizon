<section class="test-page">
  {% for block in section.blocks %}
    <div class="test-block" {{ block.shopify_attributes }}>

      {% case block.type %}

        {% when 'product' %}
          {% if block.settings.product != blank %}
            <div class="product-block">
              <h3>{{ block.settings.product.title }}</h3>
              <p>{{ block.settings.product.price | money }}</p>
            </div>
          {% endif %}

      {% endcase %}

    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Test Page",
  "blocks": [
    {
      "type": "product",
      "name": "Product Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Test Page"
    }
  ]
}
{% endschema %}