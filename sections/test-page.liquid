<section class="test-page">
  {% for block in section.blocks %}
    <div class="test-block" {{ block.shopify_attributes }}>

      {% case block.type %}

        {% when 'text' %}
          <h2>{{ block.settings.text }}</h2>

        {% when 'richtext' %}
          <div class="rte">
            {{ block.settings.content }}
          </div>

        {% when 'image' %}
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
            >
          {% endif %}

      {% endcase %}

    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Test Page",
  "blocks": [
    {
      "type": "product",
      "name": "Product Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Test Page"
    }
  ]
}
{% endschema %}